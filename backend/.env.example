PORT=5000
MONGODB_URI=mongodb://localhost:27017/eventnexus

# Used to sign/verify user session JWTs. Generate a long random value, e.g.
# `openssl rand -base64 48` — never reuse the placeholder below outside local dev.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Used to sign/verify QR ticket tokens. Optional — falls back to JWT_SECRET if
# unset, but a separate secret means rotating one doesn't invalidate the other.
QR_TOKEN_SECRET=replace_with_a_different_long_random_secret

# Origin allowed to call this API (CORS). Set to your deployed frontend URL in prod.
FRONTEND_URL=http://localhost:3000

# --- Google Sign-In ---
# OAuth 2.0 Client ID used to verify Google ID tokens on POST /api/auth/google.
# Must be the SAME client ID the frontend uses (NEXT_PUBLIC_GOOGLE_CLIENT_ID).
# Create one at https://console.cloud.google.com/apis/credentials
#   → "Create Credentials" → "OAuth client ID" → "Web application"
#   → add http://localhost:3000 to "Authorized JavaScript origins".
# Leave blank to disable Google login (email/password still works).
GOOGLE_CLIENT_ID=

# Comma-separated emails auto-granted the "admin" role when they sign in
# (Google or local). Case-insensitive. Example: alice@corp.com,bob@corp.com
ADMIN_EMAILS=anjaliimiishra321@gmail.com

# --- AI (chatbot phrasing only) ---
# Both are optional and free-tier. The chatbot always computes its answer from
# real DB data first (chatbotController.js); these just make the reply read more
# naturally. Groq is tried first, then Gemini, then the app falls back to the
# plain rule-based sentence — the chatbot works with neither key set.
#
# Groq (free): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
#
# Gemini (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Payments (Stripe Checkout) ---
# Optional. Leave STRIPE_SECRET_KEY blank to keep the app free-events-only —
# GET /api/payments/config reports { enabled: false } and the checkout button
# on paid events is hidden. Get test keys at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Signing secret for the webhook endpoint (POST /api/payments/webhook), shown
# when you create the endpoint in the Stripe dashboard or via `stripe listen`.
# Without it, webhook payloads are trusted unsigned — fine for local `stripe
# listen` testing, required in any real deployment.
STRIPE_WEBHOOK_SECRET=

# Base URL of the EventNexus backend API.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Google OAuth 2.0 Web Client ID for "Sign in with Google".
# Must be the SAME value as the backend's GOOGLE_CLIENT_ID.
# Create at https://console.cloud.google.com/apis/credentials and add
# http://localhost:3000 to "Authorized JavaScript origins".
# Leave blank to hide the Google button (email/password login still works).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

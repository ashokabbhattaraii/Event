# Port the FastAPI AI service listens on.
AI_PORT=8000

# MongoDB the EventNexus backend uses (same URI as backend/.env).
MONGODB_URI=mongodb://localhost:27017/eventnexus

# Directory where trained models (joblib) are persisted. Relative to this
# file's folder if not absolute.
MODELS_DIR=./models

# --- LLM (llm.py — Groq/Gemini calls) ---
# Optional. Both free-tier. Gemini is tried first (better instruction
# following for structured replies), Groq second. Without either set,
# POST /generate returns { reply: null } and the backend's own
# aiClient.js falls back to calling Groq/Gemini directly from Node using
# these same keys read from backend/.env — set both files to the same
# values so behavior doesn't differ between the two fallback paths.
#
# Groq (free): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
#
# Gemini (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

PORT=5000
MONGODB_URI=mongodb://localhost:27017/eventnexus

# Used to sign/verify user session JWTs. Generate a long random value, e.g.
# `openssl rand -base64 48` — never reuse the placeholder below outside local dev.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
# Refresh-token lifetime; each refresh rotates the token (see utils/tokens.js).
# A refresh-token session expires server-side via this value even if a client
# keeps replaying an old token.
JWT_REFRESH_EXPIRES_IN=30d

# Used to sign/verify QR ticket tokens. Optional — falls back to JWT_SECRET if
# unset, but a separate secret means rotating one doesn't invalidate the other.
QR_TOKEN_SECRET=replace_with_a_different_long_random_secret

# Origin allowed to call this API (CORS). Set to your deployed frontend URL in prod.
FRONTEND_URL=http://localhost:3000

# --- Google Sign-In ---
# OAuth 2.0 Client ID used to verify Google ID tokens on POST /api/auth/google.
# Must be the SAME client ID the frontend uses (NEXT_PUBLIC_GOOGLE_CLIENT_ID).
# Create one at https://console.cloud.google.com/apis/credentials
#   → "Create Credentials" → "OAuth client ID" → "Web application"
#   → add http://localhost:3000 to "Authorized JavaScript origins".
# Leave blank to disable Google login (email/password still works).
GOOGLE_CLIENT_ID=

# Comma-separated emails auto-granted the "admin" role when they sign in
# (Google or local). Case-insensitive. Example: alice@corp.com,bob@corp.com
ADMIN_EMAILS=anjaliimiishra321@gmail.com

# --- Email (nodemailer) ---
# Required in production — emails will only be logged to console if unset.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your@gmail.com,
# and SMTP_PASS=your_app_password (not your login password — use App Password).
# For Mailhog (local testing): SMTP_HOST=mailhog, SMTP_PORT=1025, leave
# SMTP_USER/SMTP_PASS blank. For other providers, consult their docs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=EventNexus <noreply@eventnexus.dev>

# --- AI (utils/aiClient.js + utils/aiProvider.js) ---
# The Python AI service (ai-service/, see below) is the PRIMARY place
# Groq/Gemini calls actually happen (ai-service/llm.py, via its POST
# /generate endpoint) — utils/aiProvider.js's direct-from-Node Groq/Gemini
# calls are now only a fallback for when that service itself is
# unreachable, so the keys below should normally match ai-service/.env's
# (same accounts, kept in sync) rather than being a separate integration.
#
# The chatbot (chatbotController.js) answers known intents entirely from
# real DB data, with no LLM involved — grounded, deterministic replies that
# can't drop or garble a fact. An LLM is only used (a) to classify a
# message into one of those intents when the regex cascade and the ML
# classifier (also ai-service, via /parse) both miss (with recent
# conversation history as context), (b) to phrase a one-line "why" for each
# recommendation from the scorer's own factors, and (c) as an absolute last
# resort, to answer free-form strictly from injected event data. Without
# either key set (in either file), unmatched messages just fall back to the
# static "here's what I can do" prompt instead, and recommendations get
# deterministic reasons.

# --- Python AI service (ai-service/, FastAPI) ---
# Base URL of the trained-model microservice. Optional: when unreachable or
# without models, attendance forecasts, recommendations, intent
# classification, and LLM calls all fall back to deterministic/local Node
# behavior. Run with `uvicorn app:app` inside ai-service.
AI_SERVICE_URL=http://localhost:8000
#
# Local fallback only (see note above) — the primary copies of these live in
# ai-service/.env.
# Groq (free): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
#
# Gemini (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Payments: Stripe Checkout (card, international) ---
# Optional. Leave STRIPE_SECRET_KEY blank to keep card payments off — GET
# /api/payments/config reports { enabled: false } and the "Pay by card"
# button is disabled (eSewa below still works). Get test keys at
# https://dashboard.stripe.com/test/apikeys
#
# NOTE: Stripe can't settle in NPR (event prices default to NPR — this app
# targets Nepal), so an NPR event's card charge is converted to USD at
# checkout time using NPR_USD_RATE below (see utils/currency.js). The
# event's own listed NPR price is never changed — only what Stripe charges
# the card.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Signing secret for the webhook endpoint (POST /api/payments/webhook), shown
# when you create the endpoint in the Stripe dashboard or via `stripe listen`.
# Without it, webhook payloads are trusted unsigned — fine for local `stripe
# listen` testing, required in any real deployment.
STRIPE_WEBHOOK_SECRET=
# Approximate NPR-per-1-USD rate used only for the Stripe conversion above.
NPR_USD_RATE=133

# --- Payments: eSewa (Nepal, native NPR) ---
# Fully optional to set — all four vars below default in code
# (utils/esewa.js) to eSewa's own published UAT/sandbox test credentials, so
# "Pay with eSewa" already works against the test gateway with zero setup.
# Override with real merchant credentials + the production URLs
# (https://epay.esewa.com.np/... instead of rc-epay.esewa.com.np) when
# going live.
ESEWA_PRODUCT_CODE=
ESEWA_SECRET_KEY=
ESEWA_FORM_URL=
ESEWA_STATUS_URL=
